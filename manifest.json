{
  "manifest_version": 3,
  "name": "FB Video Downloader — Tải video Facebook chất lượng cao",
  "version": "1.0.3",
  "description": "Bắt link video/Reels Facebook và tải về ở chất lượng cao nhất: MP4 HD trực tiếp, hoặc DASH bitrate cao nhất ghép sẵn audio bằng ffmpeg.",
  "default_locale": "vi",
  "permissions": ["downloads", "storage"],
  "host_permissions": [
    "https://*.facebook.com/*",
    "https://*.fbcdn.net/*"
  ],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "FB Video Downloader",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
  },
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "content_scripts": [
    {
      "matches": ["https://*.facebook.com/*", "https://*.messenger.com/*"],
      "js": ["content/injector.js"],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": true
    },
    {
      "matches": ["https://*.facebook.com/*", "https://*.messenger.com/*"],
      "js": ["content/content.js"],
      "css": ["content/overlay.css"],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["downloader/*", "vendor/*", "icons/*"],
      "matches": ["https://*.facebook.com/*", "https://*.messenger.com/*"]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  }
}
